# ============================================================
# AdmitPath — Required Environment Variables
# Copy to .env.local for local dev. Set in Vercel for production.
# NEVER commit .env.local or any real keys to git.
# ============================================================

# --- DATABASE (Supabase or Neon) ---
DATABASE_URL="postgresql://user:password@host:5432/admitpath?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/admitpath"

# --- GOOGLE OAUTH + SIGNED SESSION ---
GOOGLE_CLIENT_ID="...apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="..."
# Generate at least 32 random bytes. Do not reuse an OAuth or Stripe secret.
SESSION_SECRET=""
# Optional separate signer for referral links; SESSION_SECRET is used if omitted.
REFERRAL_SECRET=""
# Required for one-click unsubscribe links in email headers.
UNSUBSCRIBE_SECRET=""

# --- STRIPE ---
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# Monthly recurring Pro price only. No annual plan and no free trial.
STRIPE_PRICE_PRO="price_..."

# --- AI ROUTING (Cerebras primary → Groq fallback) ---
CEREBRAS_API_KEY="csk-..."

# Groq rotation pool — add up to 40 keys (lib/groq.ts loads 1..40)
GROQ_API_KEY_1="gsk_..."
GROQ_API_KEY_2="gsk_..."
GROQ_API_KEY_3="gsk_..."
# ... add up to GROQ_API_KEY_40

# --- ANTHROPIC (Tier 3 LLM — Pro-only essay coaching, why-us specificity) ---
# Optional. When set, Pro-tier users get Claude Sonnet for deep essay
# coaching via lib/llm-router.ts. Without it, Pro falls through to Groq.
ANTHROPIC_API_KEY=""

# --- CLAUDE-FIRST MODE (training data collection) ---
# Set to "true" to route ALL LLM calls through Claude instead of Groq.
# Use this for 5 days to collect gold-standard training data, then switch
# back to Groq with the collected data improving prompts/fine-tuning.
USE_CLAUDE_PRIMARY="false"

# Set to "true" to log every LLM input/output pair for fine-tuning.
# Data saved to TrainingExample table (run prisma db push first).
# Export via GET /api/admin/training-data?format=jsonl
COLLECT_TRAINING_DATA="false"

# --- WEB SEARCH (optional — enriches counselor for unknown schools) ---
# SerpAPI key for live Google search when students ask about schools
# not in our 102-school database. Without it, counselor uses a research
# guide fallback. Get a key at https://serpapi.com
SERP_API_KEY=""

# --- EMAIL (Resend) ---
RESEND_API_KEY="re_..."
# Newsletter audience ID for /api/newsletter subscriber management.
RESEND_AUDIENCE_ID=""
EMAIL_FROM="AdmitPath <noreply@your-verified-domain.example>"

# --- APP CONFIG ---
NEXT_PUBLIC_APP_URL="https://admith.vercel.app"

# --- RATE LIMITING (Upstash Redis; optional — falls back to in-memory) ---
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- CRON / ADMIN ---
# Required for /api/cron/*. Use a long random string.
CRON_SECRET=""
# Dedicated bearer token for detailed /api/health telemetry. CRON_SECRET is used if omitted.
HEALTHCHECK_SECRET=""
# Comma-separated authenticated user emails allowed to access /admin. Required; no fallback.
ADMIN_EMAILS=""
# Dedicated token for consent-filtered training-data export. Fail-closed when unset.
ADMIN_TRAINING_EXPORT_TOKEN=""
# Where audit/cron failure alerts are sent.
ALERT_EMAIL=""

# --- OPTIONAL INTEGRATIONS ---
# SEMrush college keyword data (optional; lib/semrush.ts no-ops when unset).
SEMRUSH_API_KEY=""

# IndexNow key for instant search-engine indexing (lib/indexnow.ts).
# Generate a 32-char hex key, set it here AND in public/<key>.txt.
INDEXNOW_KEY=""

# Legacy monthly Pro alias retained only for existing deployments.
STRIPE_PRO_PRICE_ID=""
